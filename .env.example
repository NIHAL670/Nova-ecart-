# ============================================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to backend/.env and fill in real values before running.
# ============================================================================

# --- Server ---
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed cross-origin domains
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Database (MongoDB) ---
# Local:  mongodb://127.0.0.1:27017/<db_name>
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/<db_name>
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set to "true" in production when served over HTTPS so cookies use Secure flag
COOKIE_SECURE=false

# --- Redis (optional caching / rate limiting / sessions) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# --- Cloudinary (image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Nodemailer (email verification, OTP, password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nova Cart <noreply@novacart.com>"
# Base URL of the frontend used in emails (verify / reset links)
CLIENT_URL=http://localhost:3000

# --- Payments ---
# "stripe" | "razorpay" | "cod" | "both" — default gateway for checkout
DEFAULT_PAYMENT_GATEWAY=both
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin bootstrap (first admin user created by seed script) ---
ADMIN_EMAIL=admin@novacart.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME="Nova Admin"

# --- Tax & shipping defaults ---
DEFAULT_TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=100
STANDARD_SHIPPING_FEE=8
# Comma separated: min(USD) -> max(USD)
NUMERICAL_PRECISION=2

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to frontend/.env.local
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000